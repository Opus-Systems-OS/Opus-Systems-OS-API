# opus-api reads these; on the droplet they live in Iron-Fleet's
# deploy/droplet/.env alongside the control plane's (each service ignores
# what it doesn't know).
PORT=8100
DATABASE_PATH=/data/opus-api.db
# Compose DNS; the control plane is never reached over the public internet.
CONTROL_PLANE_URL=http://control-plane:8080
# The control plane's own bearer — the API's upstream credential. Already in
# the droplet .env for mcp-fleet.
CONTROL_PLANE_TOKEN=
RUST_LOG=info,tower_http=info
# Per-key requests per minute (sustained and burst); 0 disables. Default 300.
#RATE_LIMIT_PER_MINUTE=300
# Comma-separated exact origins for CORS. Unset = no CORS headers (native
# clients need none).
#ALLOWED_ORIGINS=https://example.invalid
# Jarvis's voice (Fish Audio). Unset FISH_AUDIO_API_KEY = no /v1/voice/*.
# API credit is separate from platform credit at fish.audio; with none, the
# default model answers 402 — s2.1-pro-free works with the same voice.
#FISH_AUDIO_API_KEY=
#JARVIS_VOICE_ID=d0fa91bb6d344790bd700389e80e5ccd
#FISH_AUDIO_MODEL=s2.1-pro-free
